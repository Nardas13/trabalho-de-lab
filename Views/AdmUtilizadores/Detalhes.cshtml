@model AutoHubProjeto.Models.Utilizador

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Detalhes do Utilizador";
}

<h1>Detalhes do Utilizador</h1>

<div class="admin-detail-card">

    <!-- INFO PRINCIPAL -->
    <div class="detail-grid">

        <div class="detail-item">
            <span class="detail-label">Nome</span>
            <span class="detail-value">@Model.Nome</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">Email</span>
            <span class="detail-value">@Model.Email</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">Estado</span>
            <span class="detail-value">@Model.EstadoConta</span>
        </div>

        <div class="detail-item">
            <span class="detail-label">Tipo</span>
            <span class="detail-value">
                @if (Model.Administrador != null)
                {
                    <text>Administrador</text>
                }
                else if (Model.Vendedor != null && Model.Vendedor.Aprovado)
                {
                    <text>Vendedor</text>
                }
                else if (Model.Vendedor != null && !Model.Vendedor.Aprovado)
                {
                    <text>Pedido de Vendedor (pendente)</text>
                }
                else
                {
                    <text>Comprador</text>
                }
            </span>
        </div>

    </div>


    <!-- MOTIVO BLOQUEIO -->
    @if (!string.IsNullOrWhiteSpace(Model.MotivoBloqueio))
    {
        <div class="detail-alert">
            <strong>Motivo do bloqueio:</strong>
            <span>@Model.MotivoBloqueio</span>
        </div>
    }

    <!-- ATUALIZAR PERFIL -->
    <div class="section-divider"></div>

    @if (Model.Vendedor != null && !Model.Vendedor.Aprovado)
    {
        <h2>Pedido de Vendedor</h2>

        <p class="estado-muted" style="margin-top: 6px;">
            Este utilizador solicitou tornar-se vendedor.
            Avalia o pedido abaixo.
        </p>

        <div class="detail-actions" style="margin-top: 18px;">

            <a href="/AdmUtilizadores/Index" class="btn-outline">
                Voltar
            </a>

            <form method="post" action="/AdmUtilizadores/AprovarVendedor" style="display:inline;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-success">
                    Aprovar Vendedor
                </button>
            </form>

            <form method="post" action="/AdmUtilizadores/RejeitarVendedor" style="display:inline;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-outline-danger">
                    Rejeitar Pedido
                </button>
            </form>

        </div>
    }
    else
    {
        <div class="detail-actions">
            <a href="/AdmUtilizadores/Index" class="btn-outline">
                Voltar
            </a>
        </div>
    }

</div>
