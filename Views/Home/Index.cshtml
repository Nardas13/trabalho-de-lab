@model List<AutoHubProjeto.Models.Anuncio>

@{
    ViewData["Title"] = "Início";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<section class="home-hero">
    <div class="home-hero-content">
        <h1>O teu próximo carro está à distância de um clique</h1>
        <p>Explora a nossa seleção de veículos usados de qualidade premium.</p>
        <a href="/Anuncios/Index" class="btn-home-hero">Ver Anúncios</a>
    </div>
</section>

<section class="home-featured">
    <div class="container">
        <h2 class="section-title">Anúncios em destaque</h2>

        <div class="home-grid">
            @foreach (var anuncio in Model)
            {
                var img = anuncio.AnuncioImagems
                .OrderBy(i => i.Ordem)
                .FirstOrDefault()?.Url ?? "imgs/carros.jpg";

                <article class="home-card">
                    <div class="img-wrapper">
                        <img src="~/@img" alt="@anuncio.Titulo">

                        @if (anuncio.Estado == "vendido")
                        {
                            <div class="sold-banner">VENDIDO</div>
                        }
                        else if (anuncio.Estado == "reservado")
                        {
                            <div class="reserved-banner">RESERVADO</div>
                        }
                    </div>

                    <div class="home-card-body">
                        <h3>@anuncio.IdVeiculoNavigation.Marca @anuncio.IdVeiculoNavigation.Modelo</h3>
                        <p>€ @anuncio.Preco.ToString("N0")</p>
                        <a href="/Veiculos/Detalhes/@anuncio.IdAnuncio" class="btn">Ver Detalhes</a>
                    </div>
                </article>

            }
        </div>
    </div>
</section>

