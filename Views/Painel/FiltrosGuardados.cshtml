@model AutoHubProjeto.ViewModels.FiltrosGuardadosVM

<link rel="stylesheet" href="/css/painel.css">
<link rel="stylesheet" href="/css/painel-visitas.css">

<div class="painel-wrapper">
    @await Component.InvokeAsync("MenuPainel")

    <section class="painel-content">

        <h2 class="painel-title">Filtros Guardados</h2>
        <div class="painel-subtitle">
            Filtros que guardaste para usar rapidamente.
        </div>

        <div class="section-divider"></div>

        <div class="visitas-wrapper">
            <div class="visitas-list">

                @if (!Model.Filtros.Any())
                {
                    <p class="empty">Ainda não guardaste filtros.</p>
                }
                else
                {
                    foreach (var f in Model.Filtros)
                    {
                        <div class="visita-card">

                            <div class="visita-info">
                                <h4>@f.Nome</h4>
                                <span class="visita-data">@f.Descricao</span>
                            </div>
                            <div class="fav-actions">
                            <a href="/FiltrosFavoritos/Aplicar?id=@f.IdFiltro"
                               class="btn-view">
                                Aplicar
                            </a>

                            <button class="btn-remover-filtro cancel-btn"
                                    data-id="@f.IdFiltro">
                                Remover
                            </button>
                            </div>
                        </div>
                    }
                }

            </div>
        </div>

    </section>
</div>

<script src="/js/painel-filtros.js"></script>


<!-- ================= MODAL TIPO VENDEDOR ================= -->
<div id="tipoVendedorModal" class="modal hidden">
    <div class="cancel-box">

        <h2>Tipo de Vendedor</h2>

        <p class="cancel-text">
            Seleciona o tipo de vendedor.
            Esta escolha define os dados obrigatórios.
        </p>

        <form method="post" action="/Painel/Tornar">
            <div class="field" style="gap:10px">
                <label>
                    <input type="radio" name="Tipo" value="particular" checked />
                    Particular
                </label>

                <label>
                    <input type="radio" name="Tipo" value="empresa" />
                    Empresa
                </label>
            </div>

            <div class="modal-buttons">
                <button type="button" class="btn-outline" id="cancelTipoVendedor">
                    Cancelar
                </button>

                <button type="submit" class="btn">
                    Confirmar
                </button>
            </div>
        </form>

    </div>
</div>

<script src="/js/modals.js"></script>
