@model AutoHubProjeto.ViewModels.PainelDashboardVM
@using Microsoft.AspNetCore.Http

<link rel="stylesheet" href="/css/painel.css" />

<div class="painel-wrapper">

    @await Component.InvokeAsync("MenuPainel")

    <section class="painel-content">

        <!-- TÍTULO -->
        <h2 class="painel-title">Visão Geral</h2>
        <div class="painel-subtitle">Acompanha o teu progresso no AutoHub.</div>

        <!-- CARDS -->
        <h3 class="painel-section-title">Atividade como Comprador</h3>
        <div class="stats-grid">

            <div class="stat-card">
                <span class="label">Favoritos</span>
                <span class="value">@Model.FavoritosCount</span>
            </div>

            <div class="stat-card">
                <span class="label">Visitas</span>
                <span class="value">@Model.VisitasCount</span>
            </div>

            <div class="stat-card">
                <span class="label">Reservas</span>
                <span class="value">@Model.ReservasCount</span>
            </div>

            <div class="stat-card">
                <span class="label">Compras</span>
                <span class="value">@Model.ComprasCount</span>
            </div>

        </div>

        <!-- DIVISOR -->
        <div class="section-divider"></div>

        <!-- VENDEDOR -->
        <h3 class="painel-section-title">Ferramentas do Vendedor</h3>

        @if (Model.IsVendedor && Model.IsVendedorAprovado)
        {
            <div class="stats-grid">

                <!-- ANÚNCIOS ATIVOS -->
                <a href="/Painel/MeusAnuncios" class="stat-card stat-card-action">
                    <span class="label">Anúncios Ativos</span>
                    <span class="value">@Model.AnunciosCount</span>
                </a>

                <!-- CRIAR ANÚNCIO -->
                <a href="/Painel/MeusAnuncios" class="stat-card stat-card-action create">
                    <span class="label">Criar Anúncio</span>
                    <span class="value">+</span>
                </a>

            </div>
        }

        else if (Model.IsVendedor && !Model.IsVendedorAprovado)
        {
            <div class="seller-pending">
                <span class="pending-dot"></span>
                <p>
                    O teu pedido para te tornares vendedor está
                    <strong>em análise</strong>.
                </p>
            </div>
        }
        else
        {
            <div class="seller-locked clean">
                <p>Esta área ficará disponível quando ativares o modo vendedor.</p>
            </div>
        }

        <!-- DIVISOR -->
        <div class="section-divider"></div>

        <!-- ATIVIDADE RECENTE -->
        <h3 class="painel-section-title">Atividade Recente</h3>

        <div class="estado-muted">

            @if (Model.Atividade.Count == 0)
            {
                <p>Nada para mostrar por agora.</p>
            }
            else
            {
                <ul class="activity-list">
                    @foreach (var item in Model.Atividade)
                    {
                        <li>
                            <span class="act-dot"></span>
                            <strong>@item.Tipo:</strong>
                            <span class="activity-title">@item.Titulo</span>
                            <span class="act-time">@item.TempoDecorrido</span>

                        </li>
                    }
                </ul>
            }

        </div>

    </section>
</div>


<!-- ================= MODAL TIPO VENDEDOR ================= -->
<div id="tipoVendedorModal" class="modal hidden">
    <div class="cancel-box">

        <h2>Tipo de Vendedor</h2>

        <p class="cancel-text">
            Seleciona o tipo de vendedor.
            Esta escolha define os dados obrigatórios.
        </p>

        <form method="post" action="/Painel/Tornar">
            <div class="field" style="gap:10px">
                <label>
                    <input type="radio" name="Tipo" value="particular" checked />
                    Particular
                </label>

                <label>
                    <input type="radio" name="Tipo" value="empresa" />
                    Empresa
                </label>
            </div>

            <div class="modal-buttons">
                <button type="button" class="btn-outline" id="cancelTipoVendedor">
                    Cancelar
                </button>

                <button type="submit" class="btn">
                    Confirmar
                </button>
            </div>
        </form>

    </div>
</div>

<script src="/js/modals.js"></script>
