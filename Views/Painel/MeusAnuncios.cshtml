@model MeusAnunciosVM

<link rel="stylesheet" href="/css/painel.css" />
<link rel="stylesheet" href="/css/painel-visitas.css" />

<div class="painel-wrapper">
    @await Component.InvokeAsync("MenuPainel")

    <section class="painel-content">

        <!-- TÍTULO -->
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <h2 class="painel-title">Meus Anúncios</h2>
                <div class="painel-subtitle">
                    Gere os teus anúncios e o respetivo estado.
                </div>
            </div>

            <button id="openCriarAnuncio"
                    class="btn-view"
                    data-tipo="@Model.TipoVendedor"
                    data-nif="@Model.Nif"
                    data-faturacao="@Model.DadosFaturacao">
                    + Criar anúncio
            </button>


        </div>

        @foreach (var grupo in new[] {
                ("Anúncios Ativos", "ativo"),
                ("Anúncios Pausados", "pausado"),
                ("Anúncios Reservados", "reservado"),
                ("Anúncios Vendidos", "vendido")
                })
        {
            var lista = Model.Anuncios
            .Where(a => a.Anuncio.Estado == grupo.Item2)
            .ToList();

            if (!lista.Any())
                continue;

            <div class="section-divider"></div>
            <h3 class="painel-section-title">@grupo.Item1</h3>

            <!-- SCROLL -->
            <div class="visitas-wrapper">
                <div class="visitas-list">

                    @foreach (var a in lista)
                    {
                        <div class="visita-card">

                            <img src="@(string.IsNullOrEmpty(a.Anuncio.AnuncioImagems.FirstOrDefault()?.Url)
                                     ? "/imgs/placeholder-car.png"
                                     : "/" + a.Anuncio.AnuncioImagems.First().Url)"
                         class="visita-img" />


                            <div class="visita-info">
                                <h4>@a.Anuncio.Titulo</h4>
                                <span class="estado-muted">
                                    @a.Anuncio.Preco.ToString("C")
                                </span>
                            </div>

                            <div class="visita-actions">

                                <a href="/Veiculos/Detalhes/@a.Anuncio.IdAnuncio"
                                   class="btn-view">
                                    Ver
                                </a>

                        @if (a.Anuncio.Estado != "vendido")
                                {
                                    <button class="btn-view open-editar-modal"
                                            data-id="@a.Anuncio.IdAnuncio"
                                            data-tem-reserva="@a.TemReserva"
                                            data-tem-visitas="@a.TemVisitas"
                                            data-tem-compras="@a.TemCompras">
                                        Editar
                                    </button>
                                }


                                @* AÇÕES POR ESTADO *@
                        @if (a.Anuncio.Estado == "ativo"
                                                || a.Anuncio.Estado == "pausado")
                                {
                                    @* Pausar / Ativar *@
                                    if (a.Anuncio.Estado == "ativo")
                                    {
                                        <form method="post"
                                              asp-action="Pausar"
                                              asp-route-id="@a.Anuncio.IdAnuncio">
                                            <button type="submit" class="btn-outline">
                                                Pausar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post"
                                              asp-action="Ativar"
                                              asp-route-id="@a.Anuncio.IdAnuncio">
                                            <button type="submit" class="btn-view">
                                                Ativar
                                            </button>
                                        </form>
                                    }

                                    @* REMOVER (MESMO BOTÃO SEMPRE) *@
                                    <button class="cancel-btn open-remover-modal"
                                            data-id="@a.Anuncio.IdAnuncio"
                                            data-titulo="@a.Anuncio.Titulo"
                                            data-tem-reserva="@a.TemReserva"
                                            data-tem-visitas="@a.TemVisitas"
                                            data-tem-compras="@a.TemCompras">
                                        Remover
                                    </button>

                                }
                                else
                                {
                                    <button class="btn-cancelado" disabled>
                                        @a.Anuncio.Estado
                                    </button>
                                }

                            </div>
                        </div>
                    }

                </div>
            </div>
        }

    </section>
</div>


<!-- MODAL CRIAR ANÚNCIO -->
<div id="criarAnuncioModal" class="modal hidden">
    <div class="cancel-box criar-anuncio-box">

        <h2>Novo Anúncio</h2>

        <form id="criarAnuncioForm"
              method="post"
              asp-action="CriarAnuncio"
              asp-controller="Painel"
              enctype="multipart/form-data"
              novalidate>
            
            <!-- TÍTULO / PREÇO -->
            <div class="form-row">
                <div class="form-group">
                    <label>Título</label>
                    <input type="text" name="Titulo" required />
                </div>

                <div class="form-group">
                    <label>Preço (€)</label>
                    <input type="number" name="Preco" required min="100" />
                </div>
            </div>

            <!-- MARCA / MODELO -->
            <div class="form-row">
                <div class="form-group">
                    <label>Marca</label>

                    <div class="custom-select">
                        <div class="selected">Selecionar</div>
                        <span class="arrow">▾</span>

                        <div class="custom-options">
                            <div data-value="Audi">Audi</div>
                            <div data-value="Bentley">Bentley</div>
                            <div data-value="BMW">BMW</div>
                            <div data-value="Jaguar">Jaguar</div>
                            <div data-value="Jeep">Jeep</div>
                            <div data-value="Land Rover">Land Rover</div>
                            <div data-value="McLaren">McLaren</div>
                            <div data-value="Mercedes-Benz">Mercedes-Benz</div>
                            <div data-value="Nissan">Nissan</div>
                            <div data-value="Porsche">Porsche</div>
                            <div data-value="Tesla">Tesla</div>


                        </div>
                    </div>

                    <input type="hidden" name="Marca" required />
                </div>

                <div class="form-group">
                    <label>Modelo</label>
                    <input type="text" name="Modelo" required />
                </div>
            </div>

            <!-- CATEGORIA / ANO -->
            <div class="form-row">
                <div class="form-group">
                    <label>Categoria</label>

                    <div class="custom-select">
                        <div class="selected">Selecionar</div>
                        <span class="arrow">▾</span>

                        <div class="custom-options">
                            <div data-value="SUV">SUV</div>
                            <div data-value="Desportivo">Desportivo</div>
                            <div data-value="Elétrico">Elétrico</div>
                            <div data-value="Luxo">Luxo</div>
                        </div>
                    </div>

                    <input type="hidden" name="Categoria" required />
                    <div class="form-error">Seleciona uma categoria</div>
                </div>

                <div class="form-group">
                    <label>Ano</label>
                    <input type="number" name="Ano" required min="1900" max="2025" />
                    <div class="form-error">Ano inválido (1900–2025)</div>
                </div>
            </div>

            <!-- KM / COMBUSTÍVEL / CAIXA -->
            <div class="form-row">
                <div class="form-group">
                    <label>Quilómetros</label>
                    <input type="number" name="Quilometragem" required min="0" max="2000000" />
                    <div class="form-error">Valor inválido</div>
                </div>

                <div class="form-group">
                    <label>Combustível</label>

                    <div class="custom-select">
                        <div class="selected">Selecionar</div>
                        <span class="arrow">▾</span>

                        <div class="custom-options">
                            <div data-value="Gasolina">Gasolina</div>
                            <div data-value="Diesel">Diesel</div>
                            <div data-value="Elétrico">Elétrico</div>
                            <div data-value="Híbrido">Híbrido</div>
                        </div>
                    </div>

                    <input type="hidden" name="Combustivel" required />
                </div>

                <div class="form-group">
                    <label>Caixa</label>

                    <div class="custom-select">
                        <div class="selected">Selecionar</div>
                        <span class="arrow">▾</span>

                        <div class="custom-options">
                            <div data-value="Manual">Manual</div>
                            <div data-value="Automática">Automática</div>
                        </div>
                    </div>

                    <input type="hidden" name="Caixa" required />
                </div>
            </div>

            <!-- LOCALIZAÇÃO -->
            <div class="form-group">
                <label>Localização</label>
                <input type="text" name="Localizacao" maxlength="100" />
            </div>

            <!-- DESCRIÇÃO -->
            <div class="form-group">
                <label>Descrição</label>
                <textarea name="Descricao" rows="4" maxlength="2000"></textarea>
            </div>

            <!-- IMAGENS -->
            <div class="form-group">
                <label>Imagens (4 obrigatórias)</label>

                <div id="imageBox" class="image-box"></div>
                <input type="file" id="imageInput" accept="image/*" hidden />
                <small>Seleciona exatamente 4 imagens</small>
                <div class="form-error" id="imageError">
                    Tens de selecionar exatamente 4 imagens
                </div>
            </div>

            <!-- BOTÕES -->
            <div class="modal-buttons">
                <button type="button" id="cancelCriar" class="btn-outline">
                    Cancelar
                </button>

                <button type="submit" id="submitAnuncio" class="btn">
                    Publicar Anúncio
                </button>

            </div>

            </form>

    </div>
</div>



<!-- MODAL REMOVER ANÚNCIO -->
<div id="removerModal" class="modal hidden">
    <div class="cancel-box">

        <h2>Remover Anúncio</h2>

        <p class="cancel-text">
            Tens a certeza que queres remover o anúncio
            <strong id="removerTitulo"></strong>?
            <br />
            Esta ação não pode ser desfeita.
        </p>

        <form method="post" asp-action="Remover" id="removerForm">
            <input type="hidden" name="id" id="removerId" />

            <div class="modal-buttons">
                <button type="button"
                        class="btn-outline"
                        id="cancelRemover">
                    Cancelar
                </button>

                <button type="submit" class="btn">
                    Confirmar
                </button>
            </div>
        </form>

    </div>
</div>



<script src="/js/meusanuncios.js"></script>
